# Always use the project-locked CocoaPods version when a Gemfile is present.
# Prevents accidental `pod install` with a globally installed version that differs
# from what Gemfile.lock pins, which would cause Podfile.lock drift.
pod() {
  if [[ -f Gemfile || -f ../Gemfile ]]; then
    bundle exec pod "$@"
  else
    command pod "$@"
  fi
}

