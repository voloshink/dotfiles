npmAuth() {
  local token npmrc="$HOME/.npmrc" tmp
  local key='//teampicnic-008971659647.d.codeartifact.eu-west-1.amazonaws.com/npm/npm-aggregate/:_authToken'
  token=$(aws codeartifact get-authorization-token \
    --profile picnic-artifacts --region eu-west-1 \
    --domain teampicnic --domain-owner 008971659647 \
    --query authorizationToken --output text) || return 1
  [[ -n "$token" && "$token" != None ]] || return 1

  tmp=$(mktemp "$npmrc.XXXXXX") || return 1
  if CODEARTIFACT_AUTH_TOKEN="$token" awk -v key="$key" '
    index($0, key "=") != 1 { print }
    END { print key "=" ENVIRON["CODEARTIFACT_AUTH_TOKEN"] }
  ' "$npmrc" > "$tmp" && mv -f "$tmp" "$npmrc"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

